# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyd
*.pyo
*.pdb

# Virtual environment
venv/
.venv/
env/

# Distribution / packaging
*.egg-info/
dist/
build/
.eggs/

# ─── Secrets ─────────────────────────────────────────────────────────────────
# Any .env file anywhere in the repo. Only the .env.example templates are committed.
.env
.env.*
!.env.example

# ─── Backend — runtime data ──────────────────────────────────────────────────

# SQLite database — regenerated automatically on first run
backend/faculty_analytics.db
*.db
*.sqlite3

# Generated Excel reports — user-session artefacts, not source files
backend/outputs/*
!backend/outputs/.gitkeep

# Uploaded user CSV files — private data, not source files
backend/uploads/*
!backend/uploads/.gitkeep

# ─── Frontend ────────────────────────────────────────────────────────────────
frontend/.next/
frontend/out/
frontend/build/
frontend/node_modules/
frontend/.env.local
frontend/.env*.local
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# ─── OS / editor junk ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.cursor/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Legacy script output ────────────────────────────────────────────────────
legacy/output/

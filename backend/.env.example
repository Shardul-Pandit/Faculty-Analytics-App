# ─── Copy this file to .env and fill in real values ──────────────────────────
# backend/.env.example — safe to commit, no real secrets here

# Auth
SECRET_KEY=change-me-to-a-long-random-string

# AI providers, tried in order as a failover chain, e.g. "gemini,openai".
# If every listed provider fails (or none has a key), the app falls back to
# rule-based analysis. Leave as "basic" to run without any API key.
AI_PROVIDER=basic

# OpenAI (only needed when "openai" is in AI_PROVIDER)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (only needed when "gemini" is in AI_PROVIDER)
GEMINI_API_KEY=
# Model to call. Check https://ai.google.dev/gemini-api/docs/models if calls fail.
GEMINI_MODEL=gemini-3.5-flash-lite

# Database
DATABASE_URL=sqlite:///./faculty_analytics.db

# Storage directories (relative to backend/)
UPLOADS_DIR=uploads
OUTPUTS_DIR=outputs

# JWT expiry in minutes (default 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

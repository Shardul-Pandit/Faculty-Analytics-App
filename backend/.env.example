# ─── Copy this file to .env and fill in real values ──────────────────────────
# backend/.env.example — safe to commit, no real secrets here

# Auth
SECRET_KEY=change-me-to-a-long-random-string

# AI provider selection: "basic" | "openai" | "gemini"
# Leave as "basic" to use rule-based analysis without any API key.
AI_PROVIDER=basic

# OpenAI (only needed when AI_PROVIDER=openai)
OPENAI_API_KEY=

# Google Gemini (only needed when AI_PROVIDER=gemini)
GEMINI_API_KEY=
# Model to call. Check https://ai.google.dev/gemini-api/docs/models if calls fail.
GEMINI_MODEL=gemini-3.5-flash-lite

# Database
DATABASE_URL=sqlite:///./faculty_analytics.db

# Storage directories (relative to backend/)
UPLOADS_DIR=uploads
OUTPUTS_DIR=outputs

# JWT expiry in minutes (default 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480
